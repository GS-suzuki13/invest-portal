# Banco de dados (usado por src/database.js)
# mysql em produção; sqlite para rodar local/demonstração sem instalar nada
DB_DIALECT=mysql
DB_HOST=__PREENCHER__
DB_PORT=3306
DB_NAME=__PREENCHER__
DB_USER=__PREENCHER__
DB_PASSWORD=__PREENCHER__

# Só usado quando DB_DIALECT=sqlite (padrão: ./data/local.sqlite)
# DB_STORAGE=./data/local.sqlite

# Servidor
PORT=5000
NODE_ENV=production

# CORS: origens permitidas, separadas por vírgula (vazio = libera todas)
FRONTEND_URL=https://seu-dominio.com

# Pasta do build do frontend. Definida = o backend serve o site em "/" e a API em "/api"
# FRONTEND_DIST=../frontend/dist

# Autenticação JWT (obrigatório) — use uma string longa e aleatória
JWT_SECRET=__GERAR_STRING_ALEATORIA_LONGA__
JWT_EXPIRES_IN=7d

# Rate limit do login (opcional). Só tentativas que falham contam.
# Padrão: 10 falhas por 15 min.
# LOGIN_RATELIMIT_MAX=10
# LOGIN_RATELIMIT_WINDOW_MIN=15
