# SPA (React Router) + política de cache — copiado para dist/ pelo Vite.

Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Arquivos e pastas que existem de verdade: serve direto
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Asset com hash que não existe mais (index.html antigo em cache do cliente
  # apontando para um bundle que já foi substituído): devolve 404 de verdade,
  # em vez de servir o index.html e o navegador tentar executar HTML como JS.
  RewriteRule ^assets/.+\.(js|mjs|css|map|woff2?|ttf|png|jpe?g|svg|gif|webp|avif)$ - [R=404,L]

  # Qualquer outra rota: entrega o index.html (o React Router resolve o path)
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # index.html NUNCA é cacheado: sempre revalida. Assim um deploy novo é
  # pego na hora, sem o usuário precisar limpar o cache do navegador.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Assets têm hash no nome (index-AbC123.js): podem ficar em cache para sempre.
  <FilesMatch "\.(js|mjs|css|woff2?|ttf|png|jpe?g|svg|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Segurança: nenhum outro site pode abrir o portal dentro de um iframe
  # (clickjacking), o navegador não "adivinha" tipo de arquivo, o endereço
  # completo não vaza para sites externos e câmera/microfone/localização
  # ficam bloqueados.
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Compressão (quando o servidor não comprime sozinho): JS/CSS/HTML menores na rede
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
</IfModule>

# Fallback de cache quando mod_headers não está disponível
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
</IfModule>
